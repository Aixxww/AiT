# AiT stack autostart knobs (sourced by /usr/local/bin/ait-stack-autostart if present).
# Proxy expired 2026-09-07: keep v7 persist/track OFF until new proxy is ready.
AIT_V7_PERSIST_TRACK=0

# Playwright browsers live under /workspace so they survive image refreshes
PLAYWRIGHT_BROWSERS_PATH=/workspace/.ms-playwright
